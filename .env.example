# Recce environment. Copy to .env and fill in your keys.
# With no keys set, Recce runs in DEMO MODE using bundled sample data,
# so you can run and demo the whole flow offline.

# Google AI Studio (Gemini) API key. Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Maps Platform key, used server-side only.
# Enable: Places API (New), Street View Static API, and Geocoding API.
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Optional defaults
RECCE_BASE_CITY=Los Angeles, CA

# Optional: comma-separated allowed CORS origins (default "*")
RECCE_CORS_ORIGINS=*
